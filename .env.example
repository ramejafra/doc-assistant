# =============================================================================
# Configuración del asistente (ejemplo)
# =============================================================================
# Copia este archivo a `.env` y rellena los valores que quieras usar.
# Si una variable no está definida, se usará el valor por defecto o un fallback
# automático (por ejemplo, modo extractivo si no hay LLM configurado).

# --- Proveedor de LLM ---
# Opciones: "openai" | "ollama" | "extractive"
LLM_PROVIDER=extractive

# --- OpenAI (solo si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (solo si LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Embeddings locales (modo por defecto) ---
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Recuperación ---
# Umbral de similitud (coseno) por debajo del cual se considera "sin información".
# Rango recomendado: 0.20 - 0.45. Más alto = más estricto.
SIMILARITY_THRESHOLD=0.30

# Número de fragmentos a recuperar por pregunta.
TOP_K=4

# Tamaño y solapamiento de los chunks de texto.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Persistencia ---
# Carpeta donde se guarda el índice FAISS y los metadatos.
INDEX_DIR=./.data/index
# Carpeta donde se copian los documentos cargados.
DOCS_DIR=./documents